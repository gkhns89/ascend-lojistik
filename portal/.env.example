# Copy to portal/.env for local development. Railway variables are configured in its dashboard.
PORT=3001
# Disabled by default. Internal prototype only; never enter real customer or financial data.
PORTAL_PREVIEW_ENABLED=false
PORTAL_PREVIEW_USER=
# Generate a random secret of at least 24 characters. Never commit it.
PORTAL_PREVIEW_PASSWORD=

PORTAL_DATA_FILE=./.data/portal.json
# Ilk yonetici hesabi bu parolayla olusturulur (kullanici adi: ascend lojistik).
# Yalnizca veritabani bosken kullanilir. Yonetici kendi parolasini belirledigi
# anda saklanan ozet degisir ve bu deger kendiliginden gecersizlesir.
# Kalici veri dosyasi tanimliysa zorunludur; en az 16 karakter.
PORTAL_BOOTSTRAP_PASSWORD=

# Tarayicilar Basic kimlik bilgisini (adres + realm) ciftine gore saklar ve
# sormadan gonderir. Kullanici yanlis parolayi kaydettiyse giris penceresi bir
# daha acilmayabilir; bu degeri degistirmek tarayiciyi yeniden sormaya zorlar.
PORTAL_PREVIEW_REALM=

PORTAL_MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@ascendlojistik.com
SMTP_PASSWORD=
SMTP_FROM=info@ascendlojistik.com
PORTAL_PUBLIC_QUOTES=false
PORTAL_QUOTE_ORIGIN=https://www.ascendlojistik.com

# Set only behind a verified HTTPS reverse proxy; no trailing slash.
PORTAL_PUBLIC_ORIGIN=

# Otomatik yedek varsayilan olarak KAPALIDIR. Yedek verinin bulundugu diske
# yazildigi icin ayni disk kaybedilirse yedek de gider; felaket korumasi
# saglamaz. Yonetici bunun yerine Kontrol Merkezi'nden "Yedegi indir" ile
# yedegi kendi sectigi yere kaydeder. Saat cinsinden bir deger girilirse
# otomatik yedek yeniden acilir (ornek: 6).
PORTAL_BACKUP_INTERVAL_HOURS=

# Optional separate mounted backup destination. Configure access outside the application.
PORTAL_BACKUP_DIRECTORY=
